// The group-pool server for the Mark Six checker. One Durable Object per
// pool, keyed by its code, holding the pool in its own SQLite storage.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marksix-pool",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Served at its own subdomain of kevinlhc.com (a Custom Domain: Cloudflare
  // makes the DNS record and certificate on the first deploy).
  "routes": [{ "pattern": "marksix-api.kevinlhc.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "POOLS", "class_name": "Pool" }]
  },
  // SQLite-backed Durable Objects are the ones the Workers free plan offers.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Pool"] }],
  // Per address: pools made, and codes looked up / connected to. (The ids
  // only need to be unique within the account: the MJ worker uses 1001-1004.)
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
    { "name": "OPEN_LIMIT", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    // Pages allowed to use the API, comma-separated, besides localhost
    // (always allowed, for development).
    "ALLOWED_ORIGINS": "https://app.kevinlhc.com"
  }
}
